# Copy to .env next to airllm_ollama_api.py (airllm-ollama-api-install.sh does this for you) and edit.
# Every value below is the default; uncomment only what you change.

# --- Model -----------------------------------------------------------------
# Start small to validate the wrapper, then switch to the 70B.
AIRLLM_MODEL_ID=Qwen/Qwen2.5-3B-Instruct
# The 70B target (gated — needs HF_TOKEN and a licence acceptance on the Hub):
# AIRLLM_MODEL_ID=meta-llama/Meta-Llama-3-70B-Instruct

# Name shown in Open WebUI's model picker. Defaults to AIRLLM_MODEL_ID.
# AIRLLM_MODEL_ALIAS=llama3:70b

# AirLLM defaults to cuda:0 internally. Set this explicitly for RAM swapping.
AIRLLM_DEVICE=cpu

# 4bit/8bit require bitsandbytes and are unreliable on CPU-only hosts.
# AIRLLM_COMPRESSION=4bit

# AirLLM's internal default is 512, which silently truncates longer prompts.
AIRLLM_MAX_SEQ_LEN=2048
AIRLLM_MAX_NEW_TOKENS=256

# Where the sharded per-layer weights are written. Point this at a fast disk
# with room to spare — a 70B needs ~150GB.
# AIRLLM_LAYER_SHARDS_PATH=/opt/airllm-ollama-api/shards

# Gated models (Llama 3) need a token from https://huggingface.co/settings/tokens
# HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxx

# Keep the ~150GB download off the root filesystem.
HF_HOME=/opt/airllm-ollama-api/hf-cache

# --- Server ----------------------------------------------------------------
# There is NO authentication. Only bind 0.0.0.0 behind a firewall or proxy.
AIRLLM_HOST=127.0.0.1
AIRLLM_PORT=11434

# Begin loading weights at boot instead of on the first request.
AIRLLM_EAGER_LOAD=true
# Seconds a request waits on a still-loading model before returning 503.
AIRLLM_LOAD_WAIT=30
# Seconds to wait for a single token before giving up. Layer swapping a 70B
# on CPU can genuinely take minutes per token.
AIRLLM_TOKEN_TIMEOUT=1800

# Version string reported to clients; Open WebUI feature-gates on it.
AIRLLM_OLLAMA_VERSION=0.32.15

AIRLLM_LOG_LEVEL=INFO
